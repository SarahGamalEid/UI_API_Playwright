<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright UI and API Test Automation Suite" verbose="1" parallel="false">

    <test name="API Tests - End-To-End &amp; Data Driven">
        <parameter name="baseUrl" value="https://reqres.in"/>
        <classes>
            <class name="com.gamil.api.tests.FirstApiTest"/>
